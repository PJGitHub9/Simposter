# Copy this file to `.env` in the repo root for local (non-Docker) development.
# `frontend/npm run api` and `npm run dev:full` load it automatically
# (`--env-file ..\.env`, relative to frontend/).
#
# None of this is required to get started — every value here can also be set
# from the Settings UI after the app is running, and the onboarding wizard
# will walk you through Plex/TMDb/library setup on first launch either way.
# This file only matters if you'd rather pre-fill values before first launch,
# or you're running the backend directly without ever touching the UI.
#
# For Docker, set these under `environment:` in docker-compose.yml instead —
# see the "Environment Variables" section in docs/GETTING_STARTED.md.

# --- Plex (required) ---
PLEX_URL=http://localhost:32400
PLEX_TOKEN=

# --- API keys ---
TMDB_API_KEY=
TVDB_API_KEY=
FANART_API_KEY=

# --- Misc ---
# LOG_LEVEL=INFO
